{
  "name": "sheets",
  "version": "1.0.0",
  "description": "Sheets — a fast, private, AI-powered sheets app: 500+ formulas, charts, tables, and real .xlsx files in your own cloud",
  "type": "module",
  "private": true,
  "author": "salim-slimani",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:worker && vite build",
    "preview": "vite preview",
    "icons": "sh dev/generate-icons.sh",
    "template:thumbnails": "node dev/generate-template-thumbnails.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:worker": "vite build --config vite.worker.config.js",
    "deploy:email-worker": "puter worker deploy src/workers/email-worker.js sheets-email"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salim-studio/sheets.git"
  },
  "bugs": {
    "url": "https://github.com/salim-studio/sheets/issues"
  },
  "homepage": "https://salim-studio.github.io/sheets/",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@xmldom/xmldom": "0.9.12",
    "lucide": "^1.28.0"
  },
  "devDependencies": {
    "jsdom": "^27.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
