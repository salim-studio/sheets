{
  "name": "sheets",
  "version": "1.0.0",
  "description": "Sheets — a fast, private, AI-powered sheets app: 500+ formulas, charts, tables, and real .xlsx files on your device",
  "type": "module",
  "private": true,
  "author": "salim-slimani",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "sh dev/generate-icons.sh",
    "template:thumbnails": "node dev/generate-template-thumbnails.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "npm run build && electron desktop/main.cjs",
    "desktop:build": "npm run build && electron-builder --win portable"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salim-studio/sheets.git"
  },
  "bugs": {
    "url": "https://github.com/salim-studio/sheets/issues"
  },
  "homepage": "https://salim-studio.github.io/sheets/",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@xmldom/xmldom": "0.9.12",
    "lucide": "^1.28.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "studio.salim.sheets",
    "productName": "Sheets",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "package.json",
      "icon.png"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.png"
    }
  },
  "main": "desktop/main.cjs"
}
